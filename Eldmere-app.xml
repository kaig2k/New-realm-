<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!-- The Eldmere desktop client: the launcher, which downloads the latest game from your server each time it starts.
     Packaged by package-client.bat / package-client.sh (after build.bat your.server:2050). -->
<application xmlns="http://ns.adobe.com/air/application/32.0">
	<id>com.eldmere.client</id>
	<filename>Eldmere</filename>
	<name>Eldmere</name>
	<versionNumber>1.0.0</versionNumber>
	<description>Eldmere: a pixel-art bullet-hell MMO.</description>
	<copyright>Eldmere</copyright>
	<initialWindow>
		<content>EldmereLauncher.swf</content>
		<title>Eldmere</title>
		<systemChrome>standard</systemChrome>
		<transparent>false</transparent>
		<visible>true</visible>
		<resizable>true</resizable>
		<minimizable>true</minimizable>
		<maximizable>true</maximizable>
		<width>1100</width>
		<height>640</height>
		<minSize>550 320</minSize>
		<renderMode>auto</renderMode>
	</initialWindow>
	<icon>
		<image16x16>eldmere_16.png</image16x16>
		<image32x32>eldmere_32.png</image32x32>
		<image48x48>eldmere_48.png</image48x48>
		<image128x128>eldmere_128.png</image128x128>
	</icon>
	<supportedProfiles>desktop extendedDesktop</supportedProfiles>
</application>
